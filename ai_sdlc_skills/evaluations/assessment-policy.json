{
  "schema_version": "2.0.0",
  "id": "RUBRIC-2",
  "frozen_before_remediation": true,
  "freeze_date": "2026-10-16",
  "timezone": "Asia/Calcutta",
  "scope": [
    "PLAN",
    "DESIGN",
    "BUILD",
    "TEST",
    "DEPLOY",
