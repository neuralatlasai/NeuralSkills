    {
      "id": "routing",
      "name": "Discovery and routing",
      "assertions": [
        {
          "id": "routing.explicit",
          "criterion": "Explicit invocation selects the intended stage on both hosts.",
          "cases": [
            "E01",
            "E02",
            "E03",
            "E04",
            "E05",
            "E06"
          ],
          "critical": false
        },
        {
          "id": "routing.implicit",
