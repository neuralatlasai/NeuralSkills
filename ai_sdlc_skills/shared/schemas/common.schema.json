        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "input_revision": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "enum": [
            "NOT_RUN",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        },
        "retries_used": {
          "type": "integer",
          "minimum": 0
        },
        "target_ref": {
          "$ref": "#/$defs/ref"
        },
        "authorization_ref": {
          "$ref": "#/$defs/ref"
        },
        "configuration_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stage": {
          "enum": [
            "PLAN",
            "DESIGN",
            "BUILD",
            "TEST",
            "DEPLOY",
            "MAINTAIN"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "operation_key",
        "action",
        "target",
        "input_revision",
        "execution",
        "receipt",
        "retries_used",
        "target_ref",
        "authorization_ref",
        "configuration_refs",
        "evidence_ids",
        "stage",
        "task_id",
        "subject_ref"
      ],
      "additionalProperties": false
