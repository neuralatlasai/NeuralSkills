    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "$ref": "#/$defs/ref"
        },
        "oracle": {
          "$ref": "#/$defs/ref"
        },
        "execution": {
          "enum": [
            "NOT_RUN",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "ERROR",
            "INCONCLUSIVE",
            "STALE",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "requirement_ids",
        "method",
        "environment",
        "oracle",
        "execution",
        "result",
        "evidence_ids",
        "limitations"
      ],
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED",
            "NOT_APPLICABLE"
          ]
        },
        "value": {},
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "value",
        "authority",
        "evidence_ids",
        "owner",
        "blocks",
        "rationale"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "RESOLVED",
                  "NOT_APPLICABLE"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "authority": {
                "not": {
                  "const": "UNRESOLVED"
                }
              },
              "evidence_ids": {
                "minItems": 1
              },
              "rationale": {
                "not": {
                  "const": "UNRESOLVED"
                }
              }
            }
          }
        }
      ]
    }
