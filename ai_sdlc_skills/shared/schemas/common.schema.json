          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "FUNCTIONAL",
            "QUALITY",
            "CONSTRAINT"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_class": {
          "enum": [
            "VERIFIED_FACT",
            "PROVIDED_CONSTRAINT",
            "DESIGN_PROPOSAL",
            "UNRESOLVED"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "priority_authority": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "owner": {
