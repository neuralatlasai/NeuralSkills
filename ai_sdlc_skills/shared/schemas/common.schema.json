        "old_revision": {
          "type": "string",
          "minLength": 1
        },
        "new_revision": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/ref"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "old_revision",
        "new_revision",
        "reason",
        "source",
        "owner"
      ],
      "additionalProperties": false
