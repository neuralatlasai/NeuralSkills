{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/action"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "actions"
  ],
  "additionalProperties": false,
  "title": "AI-SDLC execution_journal 2.0.0"
}
