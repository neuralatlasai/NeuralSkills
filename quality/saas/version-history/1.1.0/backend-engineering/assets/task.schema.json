{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neural-skills:backend-task:1.0",
  "title": "Authoritative backend task context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "objective",
    "mode",
    "evidence",
    "components",
    "stateOwnership",
    "contracts",
    "workload",
    "limits",
    "coverage",
    "decisions",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "design",
        "implement",
        "extend",
        "debug",
        "optimize",
        "review",
        "migrate"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source",
          "observation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "requirement",
              "observation",
              "assumption",
              "estimate",
              "measurement",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "description": "Actual process, network, engine/SDK/protocol versions and owners."
    },
    "stateOwnership": {
      "type": "object",
      "description": "Identity, authority, transaction/commit, derived/replay, retention and deletion owners."
    },
    "contracts": {
      "type": "object",
      "description": "Versioned API/schema/operation, credential and consistency contracts."
    },
    "workload": {
      "type": "object",
      "required": [
        "variables",
        "mix",
        "cardinality",
        "skew",
        "payload",
        "model",
        "conditions"
      ],
      "properties": {
        "variables": {
          "type": "object"
        },
        "mix": {},
        "cardinality": {},
        "skew": {},
        "payload": {},
        "model": {
          "enum": [
            "open",
            "closed",
            "not-applicable",
            "unverified"
          ]
        },
        "conditions": {
          "type": "object"
        }
      }
    },
    "limits": {
      "type": "object",
      "description": "Deadlines/retries, resource envelopes and retention; every value has basis/source."
    },
    "coverage": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "disposition",
          "verifiedScope",
          "unverifiedScope",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "L01",
              "L02",
              "L03",
              "L04",
              "L05",
              "L06",
              "L07",
              "L08",
              "L09",
              "L10",
              "L11",
              "L12",
              "L13",
              "L14",
              "L15",
              "L16",
              "L17",
              "L18",
              "L19",
              "L20",
              "L21",
              "L22",
              "L23",
              "L24"
            ]
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "IMPLEMENTED_OR_CHANGED",
              "INHERITED_VERIFIED",
              "OUT_OF_SCOPE",
              "RELEVANT_UNVERIFIED"
            ]
          },
          "verifiedScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unverifiedScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement",
          "mechanism",
          "limit",
          "failure",
          "verification",
          "artifact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "string",
            "minLength": 1
          },
          "failure": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "criterion",
          "status",
          "evidence",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
