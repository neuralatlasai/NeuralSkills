{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neural-skills:ui-ux-contract:1.0",
  "title": "UI/UX engineering shared contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objective", "scope", "output", "mode", "context", "references", "constraints", "uncertainty", "requirements", "tokens", "components", "stateOwnership", "measurements"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"enum": ["component", "page", "flow", "application", "design-system"]},
    "output": {"enum": ["specification", "editable-design", "prototype", "implementation", "audit", "refinement"]},
    "mode": {"enum": ["reproduce", "adapt", "explore", "improve-existing"]},
    "context": {
      "type": "object",
      "description": "Audience, domain, primary tasks, content/data, devices, inputs and relevant locales; omissions are explicit unknowns.",
      "additionalProperties": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "location", "role", "inspection", "limitations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "inspection": {"enum": ["supplied", "inspected", "partial", "unavailable"]},
          "limitations": {"type": "string"},
          "accessedAt": {"type": "string"},
          "version": {"type": "string"},
          "license": {"type": "string"}
        }
      }
    },
    "constraints": {"type": "object", "description": "Brand, stack/versions, supported browsers, accessibility, performance, dependencies and delivery with sources.", "additionalProperties": true},
    "uncertainty": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "kind", "statement", "consequence"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["assumption", "unknown", "question"]},
          "statement": {"type": "string", "minLength": 1},
          "consequence": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "decision", "artifact", "verification", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
          "source": {"type": "object", "additionalProperties": false, "required": ["kind", "reference"], "properties": {"kind": {"enum": ["supplied", "observed", "assumption"]}, "reference": {"type": "string", "minLength": 1}}},
          "decision": {"type": "string", "minLength": 1},
          "artifact": {"type": "string", "minLength": 1},
          "verification": {"type": "object", "additionalProperties": false, "required": ["method", "evidence"], "properties": {"method": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string"}}}},
          "status": {"enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_APPLICABLE"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "tokens": {"type": "object", "description": "Single authority for roles/values or an explicit link to existing project token source. Not automatically a DTCG document.", "additionalProperties": true},
    "components": {"type": "array", "items": {"type": "object", "required": ["id", "semantics", "inputs", "outputs", "states", "keyboard", "focus", "recovery"], "properties": {"id": {"type": "string"}, "semantics": {"type": "string"}, "inputs": {}, "outputs": {}, "states": {}, "keyboard": {"type": "string"}, "focus": {"type": "string"}, "recovery": {"type": "string"}}, "additionalProperties": false}},
    "stateOwnership": {"type": "object", "description": "Owner/source for URL, local, persisted and server state, as applicable.", "additionalProperties": true},
    "measurements": {
      "type": "array", "items": {
        "type": "object", "required": ["metric", "provenance", "unit", "runs", "conditions", "evidence"], "additionalProperties": false,
        "properties": {
          "metric": {"type": "string"}, "provenance": {"enum": ["lab", "field"]}, "unit": {"type": "string"},
          "runs": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "conditions": {"type": "object", "required": ["build", "tool", "browser", "device", "network", "cpu", "viewport", "dataset", "cache", "workload"], "additionalProperties": true, "properties": {"build": {}, "tool": {}, "browser": {}, "device": {}, "network": {}, "cpu": {}, "viewport": {}, "dataset": {}, "cache": {}, "workload": {}}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
